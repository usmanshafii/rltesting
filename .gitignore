# Third-party source documents and images (docs/sources/README.md lists each one with its URL and SHA-256): kept
# locally, not redistributed through the repository. The data read off them (CSV/JSON), the register and the guide
# are committed.
docs/sources/**/*.pdf
docs/sources/**/*.png
docs/sources/**/*.xls
docs/sources/astm/ASTM_*_from_NREL_workbook.csv
docs/sources/**/*.html
docs/sources/**/*.par
docs/sources/**/*.nc
docs/sources/**/*.zip
docs/sources/**/*.f90

# A saved web-page record of a third-party paper (docs/sources/sensor_noise): kept locally like the PDFs
docs/sources/**/*_record.txt

# Local analysis notes (e.g. text extracted from the department's FYP booklet): kept locally, not redistributed
.analysis/

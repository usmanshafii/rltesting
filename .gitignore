# Generated outputs: ignored by default. Datasets, caches, frames, weights and videos travel as zips
# (tools/m1_det2.py export-data / package-results); only small evidence summaries are versioned.
out/**
!out/**/
!out/m1/pilot/*.md
!out/m1/pilot/*.json
!out/m1/pilot/*.png
!out/m1/pilot/gallery/*
!out/m1/pilot/demo/*/*
!out/m1/m1_pilot_evidence.json
!out/m1/m1_pilot_bundle_verification.json
!out/m1/production_process.json
!out/m1/cnn/STATUS.md
!out/m1/cnn/manifest.json
!out/m1/cnn/runs/*/training.json
!out/m1/det2/manifest.json
!out/m1/det2/*.md
!out/m1/det2/report.json
!out/m1/det2/sequences.json
!out/m1/det2/test_lock.json
!out/m1/det2/cache_fingerprint.json
!out/m1/det2/learning_curves.png
!out/m1/det2/gallery/*
!out/m1/det2/runs/*/training.json
!out/m1/det2/runs/*/history.json
out/**/tmp/
tmp/
member/job_log.txt
/m1_dataset_*.zip
member/*.zip
